# Rendered by Terraform. SYNTHETIC DEMO DATA ONLY.
services:
  payment-api:
    image: python:3.12-slim
    restart: unless-stopped
    working_dir: /app
    command: ["sh", "-c", "pip install --no-cache-dir --quiet boto3 || true; exec python /app/app.py"]
    environment:
      AWS_REGION: "${aws_region}"
      AWS_DEFAULT_REGION: "${aws_region}"
      TOKEN_SIGNING_KEY_ID: "${token_key_id}"
      ACQUIRER_SECRET_ARN: "${acquirer_secret_arn}"
      TOKENS_TABLE: "${tokens_table}"
      PORT: "8080"
    volumes:
      - ./payment-api/app.py:/app/app.py:ro
    ports:
      - "8080:8080"

  modern-tls:
    image: nginx:1.27-alpine
    restart: unless-stopped
    depends_on: [payment-api]
    volumes:
      - ./payment-api/nginx-modern.conf:/etc/nginx/conf.d/default.conf:ro
      - ./certs/modern:/etc/nginx/certs:ro
    ports:
      - "443:443"

  # Intentionally weak: nginx 1.14 / OpenSSL 1.1.0 with TLS 1.0/1.1 + 3DES.
  legacy-core:
    image: nginx:1.14
    restart: unless-stopped
    volumes:
      - ./legacy-core/nginx-legacy.conf:/etc/nginx/conf.d/default.conf:ro
      - ./certs/legacy:/etc/nginx/certs:ro
    ports:
      - "8443:8443"

  # Intentionally weak: MySQL 5.7 (EOL), root password in user_data.
  legacy-mysql:
    image: mysql:5.7
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "${mysql_root_password}"
      MYSQL_DATABASE: corebank
    volumes:
      - ./mysql/seed.sql:/docker-entrypoint-initdb.d/seed.sql:ro
    ports:
      - "${mysql_bind}:3306:3306"
