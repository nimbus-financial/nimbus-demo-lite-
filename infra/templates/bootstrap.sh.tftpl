#!/usr/bin/env bash
# nimbus-demo-lite host bootstrap (runs once from cloud-init). SYNTHETIC DATA ONLY.
set -euxo pipefail
exec > >(tee -a /var/log/nimbus-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io docker-compose-v2 openssl
systemctl enable --now docker

cd /opt/nimbus
mkdir -p certs/modern certs/legacy

# Modern: ECDSA P-256 / SHA-256 self-signed cert for the TLS 1.3 front end.
openssl req -x509 -nodes -days 365 \
  -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -sha256 \
  -subj "/CN=payments.nimbus-demo-lite.local/O=Nimbus Demo (synthetic)" \
  -keyout certs/modern/server.key -out certs/modern/server.crt

# Legacy (intentionally weak): RSA-1024 / SHA-1, 10-year validity.
openssl req -x509 -nodes -days 3650 -newkey rsa:1024 -sha1 \
  -subj "/CN=core.legacy-bank.local/O=Acquired Legacy Bank (synthetic)" \
  -keyout certs/legacy/legacy.key -out certs/legacy/legacy.crt \
  || openssl req -x509 -nodes -days 3650 -newkey rsa:2048 -sha1 \
       -subj "/CN=core.legacy-bank.local/O=Acquired Legacy Bank (synthetic)" \
       -keyout certs/legacy/legacy.key -out certs/legacy/legacy.crt
chmod 0644 certs/*/*

docker compose -f /opt/nimbus/docker-compose.yml up -d

# Mount the unencrypted legacy EBS volume (attached shortly after boot).
cat > /opt/nimbus/mount-legacy.sh <<'MOUNT'
#!/usr/bin/env bash
set -u
VOL_SERIAL="$(echo "${legacy_volume_id}" | tr -d '-')"
DEV=""
for _ in $(seq 1 60); do
  DEV="$(ls /dev/disk/by-id/*"$VOL_SERIAL" 2>/dev/null | head -n1 || true)"
  [ -n "$DEV" ] && break
  sleep 10
done
[ -z "$DEV" ] && { echo "legacy volume not found"; exit 0; }
blkid "$DEV" >/dev/null 2>&1 || mkfs.ext4 -L legacydata "$DEV"
mkdir -p /data/legacy
grep -q "LABEL=legacydata" /etc/fstab || echo "LABEL=legacydata /data/legacy ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a
printf 'acct_no,holder,balance\n000111222,Jane Synthetic,1043.22\n000111223,John Synthetic,88.10\n' > /data/legacy/core-export-SYNTHETIC.csv
MOUNT
chmod +x /opt/nimbus/mount-legacy.sh
nohup /opt/nimbus/mount-legacy.sh >/var/log/nimbus-mount.log 2>&1 &

echo "nimbus-demo-lite bootstrap complete"
