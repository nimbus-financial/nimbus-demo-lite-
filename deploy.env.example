# =============================================================================
# nimbus-demo-lite - deployment parameters
#   1. Copy this file to deploy.env   (Copy-Item deploy.env.example deploy.env)
#   2. Edit every line marked  <-- CHANGE
#   3. Run  .\deploy.ps1 deploy      (or ./deploy.sh deploy)
# Syntax: KEY=value, KEY='value' or KEY="value". ${OTHER_KEY} expands to an
# earlier key. Windows paths (C:\...), Git Bash (/c/...) and WSL (/mnt/c/...)
# paths are all accepted and converted automatically. deploy.env is gitignored.
# =============================================================================

# ---------------------------------------------------------------- local paths
# Repo root. Empty = the folder that contains deploy.ps1 / deploy.sh.
REPO_ROOT='C:\relixq-demo\nimbus-demo-lite'          # <-- CHANGE if you move the folder
INFRA_DIR='${REPO_ROOT}/infra'                        # Terraform stack
APPS_DIR='${REPO_ROOT}/apps'                          # Lambda + host code
STATE_DIR='${REPO_ROOT}/.state'                       # tfstate, tfvars, plugins, outputs (keep fixed after first deploy)
ARTIFACTS_DIR='${STATE_DIR}/artifacts'                # generated Lambda zips
# Optional: path to an S3 backend config file (see infra/backend.s3.tf.example). Empty = local state.
TF_BACKEND_CONFIG=''

# ---------------------------------------------------------------- AWS account
AWS_PROFILE='nimbus-demo'                             # <-- CHANGE to your AWS CLI profile
AWS_REGION='us-east-1'
AWS_ACCOUNT_ID='123456789012'                         # <-- CHANGE (deploy refuses any other account)

# ---------------------------------------------------------------- naming
PROJECT_PREFIX='nimbus-demo-lite'
BUCKET_SUFFIX='-123456789012-demo'                    # <-- CHANGE (S3 names are global; use your account id)
COGNITO_DOMAIN_PREFIX='nimbus-demo-lite-auth-2026'    # <-- CHANGE (globally unique per region)
OWNER_EMAIL='ops@example.com'                         # <-- CHANGE (budget alerts go here)

# ---------------------------------------------------------------- sizing & cost
INSTANCE_TYPE='t3.small'
DB_INSTANCE_CLASS='db.t4g.micro'
ENABLE_BUDGET='true'
MONTHLY_BUDGET_USD='50'

# ---------------------------------------------------------------- exposure & crypto
# CIDR allowed to reach 443 / 8443 / 3306 on the demo host. Your IP/32 is safest.
ALLOWED_CIDR='0.0.0.0/0'                              # <-- CHANGE to e.g. 203.0.113.10/32
# Expose legacy MySQL :3306 to ALLOWED_CIDR (intentional finding).
ENABLE_LEGACY_EXPOSURE='true'
# Post-quantum KMS key spec: ML_DSA_65 (default) | ML_DSA_44 | ML_DSA_87 | ECC_NIST_P384 | RSA_4096
PQ_KEY_SPEC='ML_DSA_65'

# ---------------------------------------------------------------- behaviour
# true = skip the interactive "yes" prompt on deploy/destroy (same as -Yes / --yes)
AUTO_APPROVE='false'
# Terraform / AWS CLI executables (empty = found on PATH)
TERRAFORM_BIN=''
AWS_BIN=''
